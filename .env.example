# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it.

# Google Gemini (required). Get a free API key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Tavily web search (required for live hotel & activity search).
# Get a free key at https://tavily.com — until set, those specialists
# gracefully report "search unavailable" and fall back to model knowledge.
TAVILY_API_KEY=

# Optional overrides:
# Model name (default "gemini-3.5-flash-lite"; the full "gemini-3.5-flash" is
# ~20 req/day on the free tier and returns 429 RESOURCE_EXHAUSTED once used up).
TRAVEL_PLANNER_MODEL=

# Set to "true" only with a working LangSmith key; otherwise leave off to avoid
# 403 tracing spam.
TRAVEL_PLANNER_TRACING=